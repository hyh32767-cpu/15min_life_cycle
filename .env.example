# 复制为 .env 后填入百度 AK（浏览器永远不读 Server Key）。
# 服务端 Key：只供 api/ 使用；浏览器端 Key：只供百度 JSAPI 底图使用，两者分离。
BAIDU_MAP_AK=
BAIDU_MAP_SK=
# 浏览器端 AK（百度 JSAPI 4.0 底图专用，需配 Referer 白名单；经 /api/maps/config 下发）
VITE_BAIDU_MAP_AK_BROWSER=
BAIDU_TIMEOUT_S=10
# system遵循系统代理；direct仅使产品百度Web API直连，TLS校验保持开启。
BAIDU_HTTP_TRANSPORT=system
# 单进程统一请求速率；必须为有限正数，默认10 QPS，另有限制4个上游并发。
BAIDU_MAX_QPS=10
# 批量算路按路线条数计并发，并非HTTP请求数；按控制台实际权益设置。
BAIDU_MATRIX_PAIRS_PER_SECOND=3
# 如果账号有不同时间窗口权益，可用以下两项覆盖上面的矩阵每秒设置。
# 以下仅展示配置格式，不代表账号权益或持续免限流保证；启用前按自己的额度核对。
# BAIDU_MATRIX_ROUTES_PER_WINDOW=50
# BAIDU_MATRIX_WINDOW_SECONDS=4.2
# 地点检索、逆地理编码等分别控制每秒请求数。
BAIDU_INTERFACE_QPS=3
API_PORT=18080
# 可选：社区解读与智能路线的OpenCode Go密钥，仅后端读取，禁止加VITE_前缀。
# 密钥留空是示例，不包含真实凭据。模型需为当前Go账号可访问的模型。
# 接口地址在后端固定，当前不支持通过Base URL环境变量切换提供方。
# 本地开发可复用已有Go登录；生产SHUNSHOU_SERVE_WEB=1时必须显式配置。
SHUNLU_LLM_API_KEY=
SHUNLU_LLM_MODEL=deepseek-v4.1-flash
# 可选：部署服务会设置为1；开发双端运行时保持默认。
# SHUNSHOU_SERVE_WEB=1
# DATA_DIR=demo-data/v1
# LEDGER_DB=api/var/ledger.db
# CACHE_DB=api/var/cache.db
# DERIVED_DB=api/var/derived.db
